          "raw": "http://127.0.0.1:19090/system/sysUser/detail",
          "protocol": "http",
          "host": [
            "127",
            "0",
            "0",
            "1"
          ],
          "port": "19090",
          "path": [
            "system",
            "sysUser",
            "detail"
          ]
        },
        "description": "带正常 Bearer Token 请求受保护接口，网关放行，拦截器处理续期，期望 code: 1000"
      },
      "response": []
    },
    {
