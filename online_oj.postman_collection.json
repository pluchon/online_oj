{
  "info": {
    "_postman_id": "8a32b260-192a-4db5-b827-online-oj-api",
    "name": "Online OJ - 鉴权与登录测试",
    "description": "用于在 Apifox / Postman 中一键导入并验证网关鉴权过滤器与业务端 Token 拦截器",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. 管理员登录（获取Token）",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "var jsonData = pm.response.json();",
              "if (jsonData.code === 1000 && jsonData.data) {",
              "    pm.collectionVariables.set('token', jsonData.data);",
              "    console.log('Token 获取成功并已写入集合变量');",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"userAccount\": \"admin\",\n    \"password\": \"123456\"\n}"
        },
        "url": {
          "raw": "http://127.0.0.1:19090/system/sysUser/login",
          "protocol": "http",
          "host": [
            "127",
            "0",
            "0",
            "1"
          ],
          "port": "19090",
          "path": [
            "system",
            "sysUser",
            "login"
          ]
        },
        "description": "通过网关登录管理员账号，密码为 123456，响应成功后自动将 Token 存入集合变量"
      },
      "response": []
    },
    {
      "name": "2. 正常鉴权请求（带有效Token）",
