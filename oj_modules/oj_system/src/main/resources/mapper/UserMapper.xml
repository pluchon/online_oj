<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="cn.nuonuoya.system.mapper.UserMapper">

    <select id="selectUserList" resultType="cn.nuonuoya.system.domain.TbUser">
        SELECT
            user_id,
            nick_name,
            head_image,
            sex,
            phone,
            email,
            wechat,
            school_name,
            major_name,
            introduce,
            status,
            create_by,
            create_time,
            update_by,
            update_time
        FROM tb_user
        <where>
            <if test="query.userId != null">
                AND user_id = #{query.userId}
            </if>
            <if test="query.nickName != null and query.nickName.trim() != ''">
                AND nick_name LIKE CONCAT('%', #{query.nickName}, '%')
            </if>
        </where>
        ORDER BY create_time DESC, user_id DESC
    </select>

</mapper>
