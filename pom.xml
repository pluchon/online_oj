<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
		 xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
		 xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<packaging>pom</packaging>
	<modules>
		<module>oj_common</module>
		<module>oj_modules</module>
        <module>oj_api</module>
    </modules>

	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>3.5.16</version>
		<relativePath/> <!-- lookup parent from repository -->
	</parent>
	<groupId>cn.nuonuoya</groupId>
	<artifactId>online_oj</artifactId>
	<version>1.0-SNAPSHOT</version>

	<!--	统一版本管理    -->
	<properties>
		<maven.compiler.source>17</maven.compiler.source>
		<maven.compiler.target>17</maven.compiler.target>
		<spring-boot.version>3.5.16</spring-boot.version>
		<spring-cloud-alibaba.version>2025.0.0.0</spring-cloud-alibaba.version>
		<spring-cloud.version>2025.0.3</spring-cloud.version>
		<spring-ai-alibaba.version>1.1.2.3</spring-ai-alibaba.version>
		<mybatis-plus.version>3.5.17</mybatis-plus.version>
		<pagehelper.boot.version>2.1.1</pagehelper.boot.version>
		<springdoc-openapi.version>2.8.17</springdoc-openapi.version>
		<fastjson.version>2.0.43</fastjson.version>
		<jwt.version>0.9.1</jwt.version>
		<jaxb-api.version>2.4.0-b180830.0359</jaxb-api.version>
		<hutool-all.version>5.8.22</hutool-all.version>
		<transmittable-thread-local.version>2.14.4</transmittable-thread-local.version>
		<xxl-job.version>2.4.0</xxl-job.version>
		<aliyun-oss.version>3.17.4</aliyun-oss.version>
		<aliyun.dypnsapi.version>1.2.2</aliyun.dypnsapi.version>
		<oj-common-core.version>1.0-SNAPSHOT</oj-common-core.version>
		<oj-common-swagger.version>1.0-SNAPSHOT</oj-common-swagger.version>
		<oj-common-security.version>1.0-SNAPSHOT</oj-common-security.version>
		<oj-common-redis.version>1.0-SNAPSHOT</oj-common-redis.version>
		<oj-common-mybatis.version>1.0-SNAPSHOT</oj-common-mybatis.version>
		<oj-common-message.version>1.0-SNAPSHOT</oj-common-message.version>
		<oj-common-elastic.version>1.0-SNAPSHOT</oj-common-elastic.version>
		<oj_api.version>1.0-SNAPSHOT</oj_api.version>
	</properties>

	<dependencies>
		<dependency>
			<groupId>org.projectlombok</groupId>
			<artifactId>lombok</artifactId>
		</dependency>
	</dependencies>

	<!--  并不会把对应依赖的jar包引入，只是声明	-->
	<dependencyManagement>
		<dependencies>
			<!-- SpringCloud Alibaba 微服务 -->
			<dependency>
				<groupId>com.alibaba.cloud</groupId>
				<artifactId>spring-cloud-alibaba-dependencies</artifactId>
				<version>${spring-cloud-alibaba.version}</version>
				<type>pom</type>
				<scope>import</scope>
			</dependency>

			<!-- SpringCloud 微服务 -->
			<dependency>
				<groupId>org.springframework.cloud</groupId>
				<artifactId>spring-cloud-dependencies</artifactId>
				<version>${spring-cloud.version}</version>
				<type>pom</type>
				<scope>import</scope>
			</dependency>

			<!-- SpringBoot 依赖配置 -->
			<dependency>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-dependencies</artifactId>
				<version>${spring-boot.version}</version>
				<type>pom</type>
				<scope>import</scope>
			</dependency>

			<!-- Spring AI Alibaba 扩展 BOM（管理 DashScope starter，oj_ai 使用；Spring AI 版本随其传递） -->
			<dependency>
				<groupId>com.alibaba.cloud.ai</groupId>
				<artifactId>spring-ai-alibaba-extensions-bom</artifactId>
				<version>${spring-ai-alibaba.version}</version>
				<type>pom</type>
				<scope>import</scope>
			</dependency>

			<!-- PageHelper 分页插件 -->
			<dependency>
				<groupId>com.github.pagehelper</groupId>
				<artifactId>pagehelper-spring-boot-starter</artifactId>
				<version>${pagehelper.boot.version}</version>
			</dependency>

			<!-- XXL-JOB 分布式任务调度核心客户端 -->
			<dependency>
				<groupId>com.xuxueli</groupId>
				<artifactId>xxl-job-core</artifactId>
				<version>${xxl-job.version}</version>
			</dependency>

			<!-- 通用核心依赖 -->
			<dependency>
				<groupId>cn.nuonuoya</groupId>
				<artifactId>oj_common_core</artifactId>
				<version>${oj-common-core.version}</version>
			</dependency>

			<!-- Redis 缓存依赖 -->
			<dependency>
				<groupId>cn.nuonuoya</groupId>
				<artifactId>oj_common_redis</artifactId>
				<version>${oj-common-redis.version}</version>
			</dependency>

			<!-- MyBatis-Plus 依赖 -->
			<dependency>
				<groupId>cn.nuonuoya</groupId>
				<artifactId>oj_common_mybatis</artifactId>
				<version>${oj-common-mybatis.version}</version>
			</dependency>

			<!-- Elasticsearch 依赖 -->
			<dependency>
				<groupId>cn.nuonuoya</groupId>
				<artifactId>oj_common_elastic</artifactId>
				<version>${oj-common-elastic.version}</version>
			</dependency>

			<!-- 跨服务统一契约 API 依赖 -->
			<dependency>
				<groupId>cn.nuonuoya</groupId>
				<artifactId>oj_api</artifactId>
				<version>${oj_api.version}</version>
			</dependency>
		</dependencies>
	</dependencyManagement>

</project>